{
  "name": "loan-obn",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate --config prisma7.config.ts",
    "dev": "node server.mjs",
    "build": "next build",
    "start": "NODE_ENV=production node server.mjs",
    "lint": "eslint",
    "test": "node tests/run-contracts.mjs && node tests/run-ledger.mjs && npm run test:integrity && npm run test:review && npm run test:closing && npm run test:assets",
    "db:generate": "prisma generate --config prisma7.config.ts",
    "db:migrate": "tsx scripts/deploy-database.ts --dev",
    "db:seed": "RUST_LOG=info prisma db seed --config prisma7.config.ts",
    "db:seed-masterdata": "tsx prisma/seed-financial-masterdata.ts",
    "db:seed-asset-categories": "tsx prisma/seed-asset-categories.ts",
    "db:studio": "prisma studio --config prisma7.config.ts",
    "storage:sync": "tsx scripts/sync-record-files.ts",
    "db:deploy": "tsx scripts/deploy-database.ts",
    "test:integrity": "node tests/run-integrity.mjs && node --test tests/infrastructure.test.mjs",
    "test:review": "node tests/run-review.mjs",
    "test:closing": "node tests/run-closing.mjs",
    "test:assets": "node tests/run-assets.mjs && node --test tests/land-schema.test.mjs tests/property-schema.test.mjs",
    "db:backfill-land": "tsx scripts/backfill-land-register.ts"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.8",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "pdf-lib": "^1.17.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true
  }
}
