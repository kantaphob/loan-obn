# Use the private local connection generated by npm run db:setup-postgres.
DATABASE_URL="postgresql://loan_obn:CHANGE_ME@127.0.0.1:55432/loan_obn?schema=public"
PG_BIN_DIRECTORY="/opt/homebrew/opt/postgresql@18/bin"
SESSION_SECRET="replace-with-at-least-32-random-characters"
