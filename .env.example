# The app keeps its local automatic backup if Drive is offline or unavailable.
LOAN_DRIVE_BACKUP_DIR=""
# Local iCloud Drive folder for borrower PAYIN/PAYOUT/DOC archives.
LOAN_BORROWER_FILES_DIR=""
GOOGLE_APPS_SCRIPT_URL=""
GOOGLE_SYNC_TOKEN=""
